[Unit]
Description=Acer Fan Profile Sync
Documentation=https://github.com/MaksSuRitik/acer-sense
# ec_sys пишет в debugfs — монтирование должно быть завершено
After=local-fs.target dbus.service power-profiles-daemon.service
Requires=power-profiles-daemon.service

[Service]
Type=simple
ExecStartPre=/sbin/modprobe ec_sys write_support=1
ExecStart=/usr/lib/acer-sense/scripts/acer-fans.sh
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
# Служба должна иметь доступ к debugfs
SupplementaryGroups=

[Install]
WantedBy=graphical.target
